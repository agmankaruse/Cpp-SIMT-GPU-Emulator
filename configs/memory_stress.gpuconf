# Small cache and long misses make coalescing/cache behavior visible.
sms = 2
warps_per_sm = 8
lanes_per_warp = 32
registers_per_lane = 64
shared_memory_size = 32K
global_memory_size = 2M
alu_pipelines = 2
sfu_pipelines = 1
lsu_count = 1
global_memory_latency = 180
shared_memory_latency = 4
max_outstanding_memory_requests = 16
scheduler_policy = oldest_ready
cache_size = 4K
cache_line_size = 128
l1_hit_latency = 4
l1_miss_latency = 180
grid = 4
block = 256
