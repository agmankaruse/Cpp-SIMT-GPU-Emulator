# Default educational GPU architecture.
sms = 2
warps_per_sm = 8
lanes_per_warp = 32
registers_per_lane = 64
shared_memory_size = 32K
global_memory_size = 1M
alu_pipelines = 2
sfu_pipelines = 1
lsu_count = 1
